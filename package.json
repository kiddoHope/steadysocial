{
  "name": "steadysocial",
  "private": true,
  "version": "0.0.2",
  "type": "module",
  "main": "electron/main.js",
  "homepage": ".",
  "scripts": {
    "dev": "vite",
    "server": "node server/server.js",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "node scripts/dev.js",
    "electron:start": "electron .",
    "electron:build": "npm run build && electron-builder"
  },
  "dependencies": {
    "@mlc-ai/web-llm": "^0.2.79",
    "@tailwindcss/typography": "^0.5.16",
    "@tiptap/extension-placeholder": "^3.23.6",
    "@tiptap/extension-table": "^3.23.6",
    "@tiptap/extension-table-cell": "^3.23.6",
    "@tiptap/extension-table-header": "^3.23.6",
    "@tiptap/extension-table-row": "^3.23.6",
    "@tiptap/extension-typography": "^3.23.6",
    "@tiptap/pm": "^3.23.6",
    "@tiptap/react": "^3.23.6",
    "@tiptap/starter-kit": "^3.23.6",
    "body-parser": "^2.2.2",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "html2canvas": "^1.4.1",
    "idb": "^8.0.3",
    "jspdf": "^4.2.1",
    "mammoth": "^1.12.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-icons": "^5.6.0",
    "react-markdown": "^9.1.0",
    "react-router-dom": "^7.6.2",
    "recharts": "^3.8.1",
    "remark-gfm": "^4.0.1",
    "tiptap-markdown": "^0.9.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react-dom": "^19.1.6",
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "electron": "^42.0.0",
    "electron-builder": "^26.8.1",
    "typescript": "~5.7.2",
    "vite": "^6.2.0",
    "wait-on": "^9.0.10"
  },
  "build": {
    "appId": "com.steadysocial.app",
    "productName": "SteadySocial OS",
    "directories": {
      "output": "dist_electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "assets/**/*",
      "skills/**/*",
      "steadysocial-mcp-server/**/*",
      "server/*"
    ],
    "win": {
      "target": "portable",
      "icon": "assets/logo.png"
    }
  }
}
